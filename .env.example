# ── Hospital Management System – Environment Variables ──────────────────────
# Copy this to .env (never commit .env to git).
# On Render: set these in the Environment Variables dashboard instead.

# ── Django ──────────────────────────────────────────────────────────────────
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production (Render default)
DEBUG=False

# Comma-separated list of allowed hosts (use * to allow all, or your domain)
ALLOWED_HOSTS=*

# ── Database ─────────────────────────────────────────────────────────────────
# Leave unset for SQLite (default on Render)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=hms_db
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306

# ── CORS & CSRF ──────────────────────────────────────────────────────────────
# Set to your Render frontend URL, e.g. https://hms-frontend.onrender.com
FRONTEND_URL=https://your-frontend.onrender.com

# Comma-separated list of trusted origins for CSRF (your Render backend URL)
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com,https://your-frontend.onrender.com
