# ── Frontend Environment Variables ──────────────────────────────────────────
# Copy this file to .env (for local dev) or set these as Render env vars.

# URL of the deployed Django backend API.
# Local dev: leave as-is (Vite dev server calls localhost Django directly)
# Render:    set to https://your-backend-name.onrender.com/api
VITE_API_URL=http://127.0.0.1:8000/api
